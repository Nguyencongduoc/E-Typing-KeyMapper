{
  "manifest_version": 3,
  "name": "e-typing Key Remapper (Gõ phím bất kỳ -> Ký tự đúng)",
  "version": "3.6.0",
  "description": "Chỉ hoạt động khi bạn gõ phím: tự động đổi mọi phím bạn bấm trên bàn phím thành ký tự đúng tiếp theo trên e-typing.ne.jp.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.e-typing.ne.jp/*"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "e-typing Key Remapper",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.e-typing.ne.jp/*"
      ],
      "js": [
        "injected.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "*://*.e-typing.ne.jp/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
